server {
    listen ${LISTEN_PORT};
    server_name _;

    root /usr/share/nginx/html;

    # Pages always fetched fresh so UI updates show up on reload
    location = / {
        try_files /index.html =404;
        add_header Cache-Control "no-store";
    }

    # Configuration changes are only allowed directly on the backend
    location /api/admin/ {
        return 403;
    }

    # Backend API (camera frames, stats, config)
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 30s;
    }

    location / {
        try_files $uri =404;
    }
}
