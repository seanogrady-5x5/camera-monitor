server {
    listen ${LISTEN_PORT};
    server_name _;

    root /usr/share/nginx/html;

    # Pages always fetched fresh so UI updates show up on reload
    location = / {
        try_files /index.html =404;
        add_header Cache-Control "no-store";
    }

    # Alternative layouts, served side by side with the main (ambient) monitor
    location = /ambient {
        try_files /index.html =404;
        add_header Cache-Control "no-store";
    }
    location = /classic {
        try_files /classic.html =404;
        add_header Cache-Control "no-store";
    }
    location = /mission {
        try_files /mission.html =404;
        add_header Cache-Control "no-store";
    }
    location = /dashboard {
        try_files /dashboard.html =404;
        add_header Cache-Control "no-store";
    }
    location ~ \.(js|css)$ {
        try_files $uri =404;
        add_header Cache-Control "no-store";
    }

    # Configuration changes are only allowed directly on the backend
    location /api/admin/ {
        return 403;
    }

    # Backend API (camera frames, stats, config)
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        # Identifies this frontend to the backend; always overwrites any client-sent value
        proxy_set_header X-Frontend-Name "${FRONTEND_NAME}";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 30s;
    }

    location / {
        try_files $uri =404;
    }
}
